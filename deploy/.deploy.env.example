# Bunu deploy/.deploy.env olarak kopyala ve doldur (git'e girmez).
# Oracle Ubuntu sunucusunun kullanıcısı "ubuntu"dur; IP'yi Oracle panelindeki "Public IP"den al.
SERVER=ubuntu@1.2.3.4
# Oracle'ın sunucu oluştururken indirdiğin özel anahtar (private key) dosyası
SSH_KEY=C:\Users\SEN\.ssh\kimvarorda.key
# DuckDNS'te aldığın alan adı
DOMAIN=kimvarorda.duckdns.org
