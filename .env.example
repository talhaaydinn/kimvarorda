# Yerel geliştirme ayarları — .env olarak kopyala. Canlı ayarlar Render panelinde girilir (bkz. render.yaml).

# ---- Veritabanı ----
# Yerelde bir SQLite dosyası kullanılır:
DB_PATH=data/kimvarorda.db
# Canlıda (Render) Turso kullanılır. Bunları YEREL .env'e yazma: yazarsan yerel sunucu canlı veritabanını kullanır.
# TURSO_DATABASE_URL=libsql://kimvarorda-<kullanici>.turso.io
# TURSO_AUTH_TOKEN=

# ---- Sunucu ----
PORT=3001
# Admin paneli şifresi (yerelde boşsa "admin"; canlıda ZORUNLU)
# ADMIN_PASSWORD=
# Oturum imzası için uzun rastgele bir metin (canlıda Render üretir)
# SESSION_SECRET=
# Proxy arkasındaysa (Render, Caddy…) gerçek ziyaretçi IP'si için 1
# TRUST_PROXY=1

# ---- Hile koruması ----
# Bir ağdan (IP) vaka başına en fazla kaç cevap
MAX_SUBMISSIONS_PER_IP=25
# Ağ kilidi: aynı ağdan BURST_WINDOW_MIN dakika içinde BURST_LIMIT cevap gelirse
# o ağ BURST_COOLDOWN_MIN dakika boyunca cevap gönderemez (0 = kapalı).
# Dikkat: mobil operatörler binlerce kişiyi aynı IP'den çıkarabilir.
BURST_LIMIT=5
BURST_WINDOW_MIN=10
BURST_COOLDOWN_MIN=15
# IP başına dakikada en fazla cevap denemesi
SUBMIT_RATE_PER_MIN=20

# ---- "Nasıl oynanır?" videosu (npm run video:voice) ----
# elevenlabs.io → Developers → API Keys (sk_ ile başlar)
ELEVENLABS_API_KEY=
# Ses kimliği: npm run video:voice -- --voices ile listele
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
