# Admin paneli şifresi (production'da ZORUNLU)
ADMIN_PASSWORD=degistir-beni
# Oturum imzası için uzun rastgele bir metin
SESSION_SECRET=uzun-rastgele-bir-metin
PORT=3001
# Veritabanı dosyası
DB_PATH=data/kimvarorda.db
# Nginx/Caddy/Railway gibi bir proxy arkasındaysa 1 yapın (gerçek IP için)
TRUST_PROXY=1
# Bir ağdan (IP) vaka başına en fazla kaç cevap
MAX_SUBMISSIONS_PER_IP=25
# Ağ kilidi: aynı ağdan BURST_WINDOW_MIN dakika içinde BURST_LIMIT cevap gelirse
# o ağ BURST_COOLDOWN_MIN dakika boyunca cevap gönderemez (0 = kapalı).
# Dikkat: mobil operatörler binlerce kişiyi aynı IP'den çıkarabilir.
BURST_LIMIT=5
BURST_WINDOW_MIN=10
BURST_COOLDOWN_MIN=15
# IP başına dakikada en fazla cevap denemesi
SUBMIT_RATE_PER_MIN=20
NODE_ENV=production

# ---- "Nasıl oynanır?" videosu (npm run video:voice) ----
# elevenlabs.io → Profil → API Keys
ELEVENLABS_API_KEY=
# Ses kimliği: npm run video:voice -- --voices ile listele (Voice Library'den Türkçe bir ses eklemen önerilir)
ELEVENLABS_VOICE_ID=
# Türkçe destekleyen model
ELEVENLABS_MODEL=eleven_multilingual_v2
